# ===================== MAIN CONFIG =====================
# Compact session id (run: npm run session:pack -- path/to/creds.json)
SESSION_ID=
# --- multi-session (all optional) ---
# SESSION_ID_2=
# SESSION_ID_3=
# SESSION_IDS=            # many sessions in one variable (new line / comma separated)
# SESSION_ID_PART_1=      # use PART_1..N only if one session is bigger than 48 KB
# SESSION_STORE=auto      # auto | mongo | file   (auto = MongoDB when MONGODB_URI works)
# MAX_SESSIONS=10
OWNER_NUMBER=94758127752
PREFIX=.
MODE=private

# ===================== MONGODB (recommended: keeps session keys across restarts) =====================
